# ============================================
# 管理控制台：仅此 QQ 的 OneBot 私聊可管理。留空禁用；私聊不可修改该项。
ADMIN_QQ=

# ============================================
# 接入通道开关（至少启用一个）
# ============================================
# 官方通道：QQ 开放平台机器人，只能收到 @机器人 的消息
# 纯 OneBot 部署可设为 false，此时无需填写 QQ_BOT_APP_ID / SECRET
OFFICIAL_ENABLE=true
# OneBot 通道：对接 NapCatQQ 等协议端，可收到群内全部消息（无需 @）
ONEBOT_ENABLE=false

# ============================================
# QQ Bot 官方平台配置（OFFICIAL_ENABLE=true 时必填）
# 去 https://q.qq.com 创建机器人应用获取
# ============================================
QQ_BOT_APP_ID=your_app_id_here
QQ_BOT_APP_SECRET=your_app_secret_here

# ============================================
# OneBot v11 配置（ONEBOT_ENABLE=true 时必填）
# 协议端推荐 NapCatQQ，在协议端里开启「正向 WebSocket」服务
# 注意：NapCat 登录的 QQ 号不能同时登录原版 QQ 客户端
# ============================================
# NapCat 正向 WebSocket 地址（NapCat 默认 3001 端口）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 协议端若配置了 access_token 则填写，否则留空
ONEBOT_ACCESS_TOKEN=
# 机器人自身 QQ 号。留空时自动从事件 self_id 获取（用于判断是否被 @）
ONEBOT_SELF_ID=
# 单次 API 调用（发消息等）超时秒数
ONEBOT_API_TIMEOUT=15
# 同时处理的 LLM 调用上限，防止群消息洪流打爆配额
ONEBOT_MAX_CONCURRENCY=3
# 图片预识别的独立并发额度（不占上面的对话闸门）：一张图最坏要走「下载 + 两次请求」，
# 跟整轮对话抢额度会让别的会话干等
ONEBOT_IMAGE_CONCURRENCY=2
# WebSocket 心跳间隔（秒）
ONEBOT_HEARTBEAT=30
# message_id 去重窗口大小，防重连后事件重放导致重复回复
ONEBOT_DEDUP_SIZE=500
# 单条消息最多识别几张图片
ONEBOT_MAX_IMAGES=3
# 健康自检间隔（秒）：定期主动查一次 QQ 在线状态，用来发现"静默失联"；0 = 关闭
ONEBOT_PROBE_SEC=60
# 连续几次自检失败后判定连接失效，强制断开重连
ONEBOT_PROBE_FAILS=2
# QQ 掉线日志的重复间隔（秒），避免刷屏
ONEBOT_OFFLINE_ALERT_SEC=600
# 连不上协议端（NapCat 没跑 / QQ 掉登录）累计多久后告警（秒），0 = 关闭
ONEBOT_DOWN_ALERT_SEC=300

# ============================================
# 唤醒策略（仅影响 OneBot 通道的普通群聊）
# 系统只决定「何时把 AI 叫起来」；「开不开口、跟谁说话、说什么」由 AI 用 reply / skip 决定。
#   空闲   → 按概率决定要不要开一局（@ 必定开局）
#   互动中 → 原参与者或引用机器人的消息免掷骰，其他成员仍按概率判断
# 明确 @/引用其他人时不唤醒；实际回复后续期，wait 不续期，irrelevant 退出互动
# ============================================
# 空闲状态下，未被 @ 的群消息触发一次唤醒的概率（0.1 = 10%）
TRIGGER_PROBABILITY=0.1
# 互动窗口：实际回复后持续多少秒；入站消息和 wait 不自动续期
TRIGGER_ACTIVE_TIMEOUT_SEC=60
# 未 @ 消息短于该值不单独唤醒（仍进缓冲，随后面某条一起带出）
TRIGGER_MIN_LEN=2
# 唤醒时最多携带多少条群聊上下文
TRIGGER_CONTEXT_MESSAGES=8
# 未 @ 群消息里的图片是否也识别（true=机器人「看得见」群里所有人发的图，
# 图片描述会进入接话上下文；注意按张计费，false 则只有被 @ 时才识别）
TRIGGER_RECOGNIZE_IMAGES=true
# 每个群每分钟最多识别多少张图（0=不限制），防刷图把 VLM 费用与延迟拉爆
TRIGGER_IMAGE_RATE_PER_MIN=10
# 图片描述缓存条数（按图片 URL 去重，同一张图反复出现时不重复计费）
TRIGGER_IMAGE_CACHE_SIZE=200
# 群黑白名单，逗号分隔的群号；留空表示不限制（黑名单优先于白名单）
ONEBOT_GROUP_WHITELIST=
ONEBOT_GROUP_BLACKLIST=

# ============================================
# DeepSeek V4 API 配置
# 去 https://platform.deepseek.com 获取 API Key
# 文档：https://api-docs.deepseek.com/zh-cn/
# ============================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 模型参数（思考模式下 temperature/top_p 会被忽略）
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TOP_P=1.0
# 深度思考模式（true=启用 V4 思考，max=最大思考强度）
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_REASONING_EFFORT=max
# 网页搜索/抓取与搜图（按需加载对应技能后开放）；不关闭画像、跑团、导航、视频搜索或文生图
DEEPSEEK_ENABLE_SEARCH=false
# 长考提示阈值（秒）：直呼/私聊等待超过阈值后只提示一次，继续等待结果，不取消本轮。
# 旧 DEEPSEEK_ROUND_TIMEOUT_SEC 仍兼容，但仅作提示阈值，不再限制整轮时长。
DEEPSEEK_THINKING_NOTICE_SEC=60
# 每次工具调用超过阈值时提示对应技能，继续等待。
TOOL_CALL_NOTICE_SEC=30
# 服务端不可用时的熔断：连续失败（超时 / 5xx / 连不上）到这个次数后，下面这段时间内
# 不再发起请求、直接放弃本轮 —— 不回话也比两分钟后才回话强
DEEPSEEK_API_FAIL_LIMIT=3
DEEPSEEK_API_COOLDOWN_SEC=30

# ============================================
# 机器人行为配置
# ============================================
BOT_SYSTEM_PROMPT=你是一个友好的QQ群聊助手，请用简洁有趣的方式回答问题。
# 普通聊天兴趣与相处分寸（不覆盖跑团角色）；留空可只保留基础人设。
BOT_CHAT_PERSONA=喜欢游戏、音乐、电影、动漫、漫画、ACG和电脑技术，对宗教、哲学也有兴趣。兴趣影响参与倾向但不要求逢题必答。政治话题审慎克制，区分事实与观点。被骂或遇到激烈分歧时倾向轻松卖萌、适度自嘲或不接话，不对骂、不阴阳怪气、不升级冲突，不用玩笑敷衍真实求助。
# 普通聊天按模型给出的空行语义分段，最多扩展到 3 条；设为 1 可关闭自动拆分。
# 业务工具结果、跑团、图片、链接、代码和列表不自动拆分。
CHAT_MAX_SEGMENTS=3
CHAT_SEGMENT_INTERVAL_SEC=0.6
MAX_HISTORY_LENGTH=10

# ============================================
# 图片理解（DeepSeek 官方视觉接口）
# 与文字对话共用上面的 DEEPSEEK_API_KEY，无需额外 Key
# 未配置时图片识别自动跳过，不影响文字对话
# 文档：https://api-docs.deepseek.com/zh-cn/guides/vision/
# ============================================
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
# 细节档位：low（缩到 512×512，最快最省，小字会糊）/ high / original / auto
VISION_DETAIL=auto
# 看图是否走思考模式（默认 false：推理与可见回答共用 max_tokens，容易把描述挤空）
VISION_ENABLE_THINKING=false
# 需要自己下载的图（QQ CDN 等）怎么送：
#   auto（默认）= 只有内联放不下（>32MiB）才上传 Files API，其余内联 base64
#   always = 一律上传 Files API 换 file_id（请求体小，同一张图可长期复用）
#   off = 只用直传 URL / base64，超过 32MiB 直接放弃
VISION_FILES_API=auto
# 单次看图请求的读超时（秒）：看图是配菜，失败就快速失败（不重试），认不出留占位继续答
VISION_TIMEOUT_SEC=25
# 一张图识别失败后的退避窗口（秒）：窗口内不再下载、不再调用（失败不缓存会导致
# 每次唤醒都重新下载重试，白拖慢整轮）
VISION_FAIL_BACKOFF_SEC=600

# ============================================
# 表情包库（src/stickers_utils.py）
# 识别时若判定为「表情包」，就顺手把原图存到本地（文件名 = 五个标签_序号）；
# AI 想表达情绪时调用 send_sticker 工具挑一张（先用 list_stickers 看库里有什么），随回复一起发出去
# 注意：群聊和私聊里被判定为表情包的图会进同一个库 —— 私聊收到的图有可能被发到群里
# ============================================
# 是否启用表情包采集与发送
STICKER_ENABLE=true
# 库目录，留空 = <项目根>/data/stickers
STICKER_DIR=
# 库容量上限，超出后淘汰最久未使用的那张
STICKER_MAX_FILES=500
# 单张表情包大小上限（字节），默认 5MB
STICKER_MAX_BYTES=5242880
# 一轮回复里最多发几张（防刷屏）
STICKER_MAX_PER_REPLY=1

# ============================================
# 文生图（阿里云百炼 Model Studio）
# 去 https://bailian.console.aliyun.com 获取 API Key
# 未配置时文生图功能自动跳过
# ============================================
DASHSCOPE_API_KEY=
# 文生图模型（qwen-image 系列不支持 OpenAI 兼容接口，走 DashScope 原生端点）
IMAGE_GEN_MODEL=qwen-image-3.0-pro
IMAGE_GEN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ============================================
# 地图导航（高德开放平台 Web 服务）
# 去 https://console.amap.com 创建应用 → 添加 Key → 选「Web 服务」
# 需勾选「搜索POI 2.0」和「路径规划 2.0」两个服务
# 若绑定了 IP 白名单，记得把服务器出口 IP 加进去（或填 0.0.0.0/0 不限制）
# 未配置时 navi 工具会明确回报「没配置」，不会报错崩链路
# ============================================
AMAP_KEY=
# 单次请求超时（秒），失败即返不拖住整轮
AMAP_TIMEOUT_SEC=8
# 每次搜索默认返回几条 POI（1~25）
AMAP_POI_LIMIT=5

# Arbitrary URL downloads do not inherit HTTP_PROXY/HTTPS_PROXY.
# Optional trusted proxy: it must enforce target DNS/routing restrictions.
# 保留配置时也允许关闭代理：连接代理失败会在本次下载内回退直连，下次重新尝试代理。
# 若图片域名解析为 198.18.x.x（代理 fake-IP），需填写实际 HTTP/Mixed 代理地址，
# 例如 http://127.0.0.1:7890（端口以运行设备配置为准；不是 SOCKS 端口）。
TRUST_PROXY_URL=
