# ============================================
# 接入通道开关（至少启用一个）
# ============================================
# 官方通道：QQ 开放平台机器人，只能收到 @机器人 的消息
# 纯 OneBot 部署可设为 false，此时无需填写 QQ_BOT_APP_ID / SECRET
OFFICIAL_ENABLE=true
# OneBot 通道：对接 NapCatQQ 等协议端，可收到群内全部消息（无需 @）
ONEBOT_ENABLE=false

# ============================================
# QQ Bot 官方平台配置（OFFICIAL_ENABLE=true 时必填）
# 去 https://q.qq.com 创建机器人应用获取
# ============================================
QQ_BOT_APP_ID=your_app_id_here
QQ_BOT_APP_SECRET=your_app_secret_here

# ============================================
# OneBot v11 配置（ONEBOT_ENABLE=true 时必填）
# 协议端推荐 NapCatQQ，在协议端里开启「正向 WebSocket」服务
# 注意：NapCat 登录的 QQ 号不能同时登录原版 QQ 客户端
# ============================================
# NapCat 正向 WebSocket 地址（NapCat 默认 3001 端口）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 协议端若配置了 access_token 则填写，否则留空
ONEBOT_ACCESS_TOKEN=
# 机器人自身 QQ 号。留空时自动从事件 self_id 获取（用于判断是否被 @）
ONEBOT_SELF_ID=
# 单次 API 调用（发消息等）超时秒数
ONEBOT_API_TIMEOUT=15
# 同时处理的 LLM 调用上限，防止群消息洪流打爆配额
ONEBOT_MAX_CONCURRENCY=3
# WebSocket 心跳间隔（秒）
ONEBOT_HEARTBEAT=30
# message_id 去重窗口大小，防重连后事件重放导致重复回复
ONEBOT_DEDUP_SIZE=500
# 单条消息最多识别几张图片
ONEBOT_MAX_IMAGES=3
# 健康自检间隔（秒）：定期主动查一次 QQ 在线状态，用来发现"静默失联"；0 = 关闭
ONEBOT_PROBE_SEC=60
# 连续几次自检失败后判定连接失效，强制断开重连
ONEBOT_PROBE_FAILS=2
# QQ 掉线日志的重复间隔（秒），避免刷屏
ONEBOT_OFFLINE_ALERT_SEC=600
# 连不上协议端（NapCat 没跑 / QQ 掉登录）累计多久后告警（秒），0 = 关闭
ONEBOT_DOWN_ALERT_SEC=300

# ============================================
# 唤醒策略（仅影响 OneBot 通道的普通群聊）
# 系统只决定「何时把 AI 叫起来」；「开不开口、跟谁说话、说什么」由 AI 用 reply / skip 决定。
#   空闲   → 按概率决定要不要开一局（@ 必定开局）
#   互动中 → 每条消息都叫醒 AI；每轮处理完重新计时，超时没人说话就回到空闲
# ============================================
# 空闲状态下，未被 @ 的群消息触发一次唤醒的概率（0.1 = 10%）
TRIGGER_PROBABILITY=0.1
# 互动窗口：AI 处理完一轮后，多久没人说话就退出互动、回到概率唤醒（秒）
TRIGGER_ACTIVE_TIMEOUT_SEC=60
# 未 @ 消息短于该值不单独唤醒（仍进缓冲，随后面某条一起带出）
TRIGGER_MIN_LEN=2
# 唤醒时最多携带多少条群聊上下文
TRIGGER_CONTEXT_MESSAGES=8
# 未 @ 群消息里的图片是否也识别（true=机器人「看得见」群里所有人发的图，
# 图片描述会进入接话上下文；注意按张计费，false 则只有被 @ 时才识别）
TRIGGER_RECOGNIZE_IMAGES=true
# 每个群每分钟最多识别多少张图（0=不限制），防刷图把 VLM 费用与延迟拉爆
TRIGGER_IMAGE_RATE_PER_MIN=10
# 图片描述缓存条数（按图片 URL 去重，同一张图反复出现时不重复计费）
TRIGGER_IMAGE_CACHE_SIZE=200
# 群黑白名单，逗号分隔的群号；留空表示不限制（黑名单优先于白名单）
ONEBOT_GROUP_WHITELIST=
ONEBOT_GROUP_BLACKLIST=

# ============================================
# DeepSeek V4 API 配置
# 去 https://platform.deepseek.com 获取 API Key
# 文档：https://api-docs.deepseek.com/zh-cn/
# ============================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 模型参数（思考模式下 temperature/top_p 会被忽略）
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TOP_P=1.0
# 深度思考模式（true=启用 V4 思考，max=最大思考强度）
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_REASONING_EFFORT=max
# 联网搜索工具（true=模型可调用 web_search 函数自主搜索）
DEEPSEEK_ENABLE_SEARCH=false
# 单轮思考总时限（秒）：到点就放弃本轮 —— 不发消息、不写历史、退出互动窗口，
# 之后即便 API 才返回也一律丢弃（超时才到的回答在群里已经过时了）
DEEPSEEK_ROUND_TIMEOUT_SEC=60

# ============================================
# 机器人行为配置
# ============================================
BOT_SYSTEM_PROMPT=你是一个友好的QQ群聊助手，请用简洁有趣的方式回答问题。
MAX_HISTORY_LENGTH=10

# ============================================
# 视觉识别 / 文生图（阿里云百炼 Model Studio）
# 去 https://bailian.console.aliyun.com 获取 API Key
# 未配置时图片识别与文生图功能自动跳过，不影响文字对话
# ============================================
DASHSCOPE_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-flash
VISION_ENABLE_THINKING=false
VISION_HIGH_RES=false
# 文生图模型（qwen-image 系列不支持 OpenAI 兼容接口，走 DashScope 原生端点）
IMAGE_GEN_MODEL=qwen-image-3.0-pro
IMAGE_GEN_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
